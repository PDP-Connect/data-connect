{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-app-commands",
  "description": "Grants the main window's own app commands by their autogenerated allow-$command permission (see build.rs AppManifest). Scoped to \"main\" only, deliberately separate from default.json (which is shared with connector-* and must not grant app commands to that window). Declaring an AppManifest at all turns on app-command ACL enforcement everywhere, so every command main calls -- including ones with no current caller, kept reachable from main to match prior behavior -- needs an explicit grant here or it silently breaks.",
  "windows": ["main"],
  "permissions": [
    "allow-add-developer-connector-source",
    "allow-check-browser-available",
    "allow-check-connected-platforms",
    "allow-check-connector-updates",
    "allow-clear-browser-session",
    "allow-clear-personal-server-data",
    "allow-close-reference-server-view",
    "allow-debug-connector-paths",
    "allow-delete-exported-run",
    "allow-download-browser",
    "allow-download-chromium-rust",
    "allow-download-connector",
    "allow-get-app-config",
    "allow-get-installed-connectors",
    "allow-get-log-path",
    "allow-get-personal-server-data-path",
    "allow-get-personal-server-status",
    "allow-get-platforms",
    "allow-get-reference-server-status",
    "allow-get-registry-url",
    "allow-get-run-files",
    "allow-get-user-data-path",
    "allow-handle-download",
    "allow-hide-reference-server-view",
    "allow-inspect-remote-access-provider",
    "allow-is-installed-pdpp-browser-setup-complete",
    "allow-list-browser-sessions",
    "allow-list-developer-connector-sources",
    "allow-load-latest-source-export-full",
    "allow-load-latest-source-export-preview",
    "allow-load-run-export-data",
    "allow-load-runs",
    "allow-load-source-export-full-from-path",
    "allow-load-source-export-preview-from-path",
    "allow-login-reference-server",
    "allow-mark-export-synced",
    "allow-open-folder",
    "allow-open-personal-server-scope-folder",
    "allow-open-platform-export-folder",
    "allow-open-reference-server-view",
    "allow-prepare-installed-pdpp-import",
    "allow-reload-developer-connector-source",
    "allow-remove-developer-connector-source",
    "allow-reset-installed-pdpp-browser-profile",
    "allow-resize-reference-server-view",
    "allow-select-developer-connector-source",
    "allow-set-app-config",
    "allow-start-connector-run",
    "allow-start-installed-pdpp-connector-run",
    "allow-start-personal-server",
    "allow-start-reference-server",
    "allow-stop-connector-run",
    "allow-stop-installed-pdpp-connector-run",
    "allow-stop-personal-server",
    "allow-stop-reference-server",
    "allow-submit-installed-pdpp-interaction-response",
    "allow-test-nodejs",
    "allow-write-export-data"
  ]
}
