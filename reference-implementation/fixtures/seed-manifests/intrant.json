{
  "protocol_version": "0.1.0",
  "connector_id": "intrant",
  "connector_key": "intrant",
  "manifest_uri": "https://demo.pdpp.dev/rd/connectors/intrant",
  "version": "0.1.0-demo",
  "display_name": "INTRANT · Licencia de conducir (demo)",
  "runtime_requirements": {
    "bindings": {}
  },
  "capabilities": {
    "public_listing": { "tier": "development" }
  },
  "streams": [
    {
      "name": "licencias_conducir",
      "description": "Licencia de conducir: categoría, fechas de expedición y vencimiento, estado y restricciones (datos ficticios)",
      "semantics": "mutable_state",
      "schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "cedula": { "type": "string" },
          "nombre": { "type": "string" },
          "numero_licencia": { "type": "string" },
          "categoria": { "type": "string" },
          "categoria_descripcion": { "type": "string" },
          "fecha_expedicion": { "type": "string", "format": "date" },
          "fecha_vencimiento": { "type": "string", "format": "date" },
          "estado": { "type": "string" },
          "restricciones": { "type": "array", "items": { "type": "string" } },
          "tipo_sangre": { "type": "string" },
          "oficina_expedicion": { "type": "string" },
          "source_updated_at": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "categoria", "fecha_vencimiento"]
      },
      "primary_key": ["id"],
      "cursor_field": "source_updated_at",
      "consent_time_field": "source_updated_at",
      "selection": { "fields": true, "resources": true },
      "coverage_strategy": "full_inventory",
      "freshness_strategy": "manual_as_of",
      "incremental": false
    }
  ]
}
