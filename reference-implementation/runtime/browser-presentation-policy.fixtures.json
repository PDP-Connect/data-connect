      "error": "invalid_combination"
    },
    {
      "name": "headless with a native window",
      "policy": { "version": 1, "engine_mode": "headless", "display_backend": "inherited-host", "native_visibility": "normal", "interaction_presentation": "companion", "fallback": "fail-closed" },
      "error": "invalid_combination"
    },
    {
      "name": "headless with native interaction",
      "policy": { "version": 1, "engine_mode": "headless", "display_backend": "inherited-host", "native_visibility": "no-window", "interaction_presentation": "native", "fallback": "fail-closed" },
      "error": "invalid_combination"
    },
    {
      "name": "headed with no window",
      "policy": { "version": 1, "engine_mode": "headed", "display_backend": "inherited-host", "native_visibility": "no-window", "interaction_presentation": "companion", "fallback": "fail-closed" },
      "error": "invalid_combination"
    },
    {
      "name": "hidden on the user's desktop (no v1 adapter hides a window there)",
      "policy": { "version": 1, "engine_mode": "headed", "display_backend": "inherited-host", "native_visibility": "isolated-display", "interaction_presentation": "companion", "fallback": "fail-closed" },
      "error": "invalid_combination"
    },
    {
      "name": "private display shown as a normal window",
      "policy": { "version": 1, "engine_mode": "headed", "display_backend": "private-xvfb", "native_visibility": "normal", "interaction_presentation": "companion", "fallback": "fail-closed" },
      "error": "invalid_combination"
    },
    {
      "name": "private display with native interaction (the owner cannot see it)",
      "policy": { "version": 1, "engine_mode": "headed", "display_backend": "private-xvfb", "native_visibility": "isolated-display", "interaction_presentation": "native", "fallback": "fail-closed" },
      "error": "invalid_combination"
    },
    {
      "name": "external display with native interaction",
      "policy": { "version": 1, "engine_mode": "headed", "display_backend": "externally-owned", "native_visibility": "isolated-display", "interaction_presentation": "native", "fallback": "fail-closed" },
      "error": "invalid_combination"
