{
  "description": "Conformance cases for browser presentation policy v1. The TypeScript parser (runtime/browser-presentation-policy.ts) and the Rust parser (src-tauri/src/commands/browser_presentation.rs) must give each case the same verdict and error code.",
  "cases": [
    {
      "name": "headed on the user's desktop (the legacy default, written as a policy)",
      "policy": { "version": 1, "engine_mode": "headed", "display_backend": "inherited-host", "native_visibility": "normal", "interaction_presentation": "native", "fallback": "fail-closed" },
      "error": null
    },
    {
      "name": "headed on the user's desktop, interaction through the companion",
      "policy": { "version": 1, "engine_mode": "headed", "display_backend": "inherited-host", "native_visibility": "normal", "interaction_presentation": "companion", "fallback": "fail-closed" },
      "error": null
    },
    {
      "name": "headed on a private Xvfb display owned by the desktop host",
      "policy": { "version": 1, "engine_mode": "headed", "display_backend": "private-xvfb", "native_visibility": "isolated-display", "interaction_presentation": "companion", "fallback": "fail-closed" },
      "error": null
    },
    {
      "name": "headed on a display another owner supplies (container or n.eko)",
      "policy": { "version": 1, "engine_mode": "headed", "display_backend": "externally-owned", "native_visibility": "isolated-display", "interaction_presentation": "companion", "fallback": "fail-closed" },
      "error": null
    },
    {
      "name": "new headless",
      "policy": { "version": 1, "engine_mode": "headless", "display_backend": "inherited-host", "native_visibility": "no-window", "interaction_presentation": "companion", "fallback": "fail-closed" },
      "error": null
    },
    {
      "name": "unknown version",
      "policy": { "version": 2, "engine_mode": "headed", "display_backend": "private-xvfb", "native_visibility": "isolated-display", "interaction_presentation": "companion", "fallback": "fail-closed" },
      "error": "unsupported_version"
    },
    {
      "name": "unknown version with a field v1 does not know",
      "policy": { "version": 2, "engine_mode": "headed", "display_backend": "private-wayland", "native_visibility": "isolated-display", "interaction_presentation": "companion", "fallback": "fail-closed", "geometry": "1440x900" },
      "error": "unsupported_version"
    },
    {
      "name": "version as a string",
      "policy": { "version": "1", "engine_mode": "headed", "display_backend": "private-xvfb", "native_visibility": "isolated-display", "interaction_presentation": "companion", "fallback": "fail-closed" },
      "error": "invalid_shape"
    },
    {
      "name": "fractional version",
      "policy": { "version": 1.5, "engine_mode": "headed", "display_backend": "private-xvfb", "native_visibility": "isolated-display", "interaction_presentation": "companion", "fallback": "fail-closed" },
      "error": "unsupported_version"
    },
    {
      "name": "missing version",
      "policy": { "engine_mode": "headed", "display_backend": "private-xvfb", "native_visibility": "isolated-display", "interaction_presentation": "companion", "fallback": "fail-closed" },
      "error": "invalid_shape"
    },
    {
      "name": "not an object",
      "policy": "private-xvfb",
      "error": "invalid_shape"
    },
    {
      "name": "null",
      "policy": null,
      "error": "invalid_shape"
    },
    {
      "name": "array",
      "policy": [1],
      "error": "invalid_shape"
    },
    {
      "name": "unknown engine mode",
      "policy": { "version": 1, "engine_mode": "headless-shell", "display_backend": "inherited-host", "native_visibility": "no-window", "interaction_presentation": "companion", "fallback": "fail-closed" },
      "error": "invalid_shape"
    },
    {
      "name": "unknown display backend",
      "policy": { "version": 1, "engine_mode": "headed", "display_backend": "xvfb", "native_visibility": "isolated-display", "interaction_presentation": "companion", "fallback": "fail-closed" },
      "error": "invalid_shape"
    },
    {
      "name": "enum value in the wrong case",
      "policy": { "version": 1, "engine_mode": "Headed", "display_backend": "private-xvfb", "native_visibility": "isolated-display", "interaction_presentation": "companion", "fallback": "fail-closed" },
      "error": "invalid_shape"
    },
    {
      "name": "fallback that v1 does not support",
      "policy": { "version": 1, "engine_mode": "headed", "display_backend": "private-xvfb", "native_visibility": "isolated-display", "interaction_presentation": "companion", "fallback": "owner-visible-continuation" },
      "error": "invalid_shape"
    },
    {
      "name": "unknown field",
