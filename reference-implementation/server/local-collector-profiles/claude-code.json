{
	"protocol_version": "0.1.0",
	"connector_id": "https://registry.pdpp.dev/connectors/claude-code",
	"source": {
		"id": "https://registry.pdpp.dev/sources/claude_code",
		"display": {
			"name": "Claude Code"
		}
	},
	"connector_key": "claude-code",
	"manifest_uri": "https://registry.pdpp.dev/connectors/claude-code",
	"version": "0.3.4",
	"display_name": "Claude Code",
	"brand": {
		"icon": "icon.svg",
		"background_color": "#D97757"
	},
	"runtime_requirements": {
		"bindings": {
			"filesystem": {
				"required": true
			}
		},
		"environment_variables": [
			"CLAUDE_CODE_PROJECT_INCLUDE",
			"CLAUDE_CODE_PROJECT_EXCLUDE"
		],
		"local_paths": {
			"home_env_override": "CLAUDE_CODE_HOME",
			"home_default_relative_to_user_home": ".claude",
			"paths": [
				{
					"default_relative_to_home": "projects",
					"env_override": "CLAUDE_CODE_PROJECTS_DIR",
					"label": "projects directory",
					"required_for_readiness": true
				}
			]
		}
	},
	"capabilities": {
		"human_interaction": [],
		"proven": {
			"local_collector": true
		},
		"refresh_policy": {
			"recommended_mode": "automatic",
			"recommended_interval_seconds": 3600,
			"minimum_interval_seconds": 300,
			"maximum_staleness_seconds": 21600,
			"interaction_posture": "none",
			"rate_limit_sensitivity": "low",
			"bot_detection_sensitivity": "low",
			"background_safe": true,
			"rationale": "Claude Code session logs live on local disk; re-reading them is cheap and has no platform cost."
		},
		"public_listing": {
			"tier": "supported"
		}
	},
	"streams": [
		{
			"name": "sessions",
			"required": true,
			"description": "Claude Code sessions. One session = one CLI invocation in a specific project directory.",
			"compaction_class": "recurring_snapshot",
			"compaction_class_note": "aggregated per-session record; message_count/last_event_at widen on growth; never compactable, never re-alarms as growth accumulates.",
			"compaction_fingerprint": {
				"exclude_keys": []
			},
			"display": {
				"label": "Your Claude Code sessions",
				"detail": "Session start time, duration, project directory, git branch, Claude Code version, total message count."
			},
			"semantics": "mutable_state",
			"schema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"project_path": {
						"type": ["string", "null"]
					},
					"cwd": {
						"type": ["string", "null"]
					},
					"git_branch": {
						"type": ["string", "null"]
					},
					"version": {
						"type": ["string", "null"]
					},
					"started_at": {
						"type": ["string", "null"],
						"format": "date-time",
						"x_pdpp_role": "event-time"
					},
					"last_event_at": {
						"type": ["string", "null"],
						"format": "date-time"
					},
					"message_count": {
						"type": ["integer", "null"]
					},
					"title": {
						"type": ["string", "null"],
						"x_pdpp_role": "secondary"
					},
					"user_type": {
						"type": ["string", "null"]
					},
					"entrypoint": {
						"type": ["string", "null"]
					},
					"kind": {
						"type": "string",
						"enum": ["session", "subagent"]
					},
					"parent_session_id": {
						"type": ["string", "null"]
					}
				},
				"required": ["id", "kind"]
			},
			"primary_key": ["id"],
			"cursor_field": "last_event_at",
			"consent_time_field": "started_at",
			"selection": {
				"fields": true,
				"resources": true
			},
			"incremental": true,
			"relationships": [
				{
					"name": "parent_session",
					"stream": "sessions",
					"foreign_key": "parent_session_id",
					"cardinality": "has_one"
				}
			],
			"query": {
				"search": {
					"lexical_fields": [
						"project_path",
						"cwd",
						"git_branch",
						"version",
						"title",
						"user_type",
						"entrypoint"
					],
					"semantic_fields": ["title"]
				},
				"range_filters": {
					"started_at": ["gte", "gt", "lte", "lt"],
					"last_event_at": ["gte", "gt", "lte", "lt"],
					"message_count": ["gte", "gt", "lte", "lt"]
				},
				"aggregations": {
					"count": true,
					"group_by_time": ["last_event_at", "started_at"]
				}
			},
			"coverage_strategy": "checkpoint_window",
			"freshness_strategy": "device_heartbeat"
		},
		{
			"name": "messages",
			"required": true,
			"description": "Messages within Claude Code sessions: user prompts and assistant responses. Includes both top-level session transcripts and nested subagent (sidechain) transcripts.",
			"compaction_fingerprint": {
				"exclude_keys": []
			},
			"display": {
				"label": "Your Claude Code messages",
				"detail": "Role (user/assistant), text content, timestamp, parent message (for threading), session reference, subagent id when the message came from a sidechain run."
			},
			"semantics": "append_only",
			"schema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"session_id": {
						"type": "string"
					},
					"parent_uuid": {
						"type": ["string", "null"]
					},
					"role": {
						"type": ["string", "null"],
						"x_pdpp_role": "actor"
					},
					"type": {
						"type": ["string", "null"]
					},
					"content": {
						"type": ["string", "null"],
						"x_pdpp_role": "primary-title"
					},
					"timestamp": {
						"type": ["string", "null"],
						"format": "date-time",
						"x_pdpp_role": "event-time"
					},
					"is_sidechain": {
						"type": ["boolean", "null"]
					},
					"user_type": {
						"type": ["string", "null"]
					},
					"agent_id": {
						"type": ["string", "null"]
					},
					"subagent_session_id": {
						"type": ["string", "null"]
					},
					"has_pasted_content": {
						"type": "boolean"
					}
				},
				"required": ["id", "session_id", "has_pasted_content"]
			},
			"primary_key": ["id"],
			"cursor_field": "timestamp",
			"consent_time_field": "timestamp",
			"selection": {
				"fields": true,
				"resources": true
			},
			"incremental": true,
			"relationships": [
				{
					"name": "session",
					"stream": "sessions",
					"foreign_key": "session_id",
					"cardinality": "has_one"
				},
				{
					"name": "subagent_session",
					"stream": "sessions",
					"foreign_key": "subagent_session_id",
					"cardinality": "has_one"
				}
			],
			"query": {
				"search": {
					"lexical_fields": [
						"role",
						"type",
						"content",
						"user_type",
						"agent_id"
					],
					"semantic_fields": ["content"]
				},
				"range_filters": {
					"timestamp": ["gte", "gt", "lte", "lt"]
				},
				"aggregations": {
					"count": true,
					"group_by_time": ["timestamp"]
				}
			},
			"coverage_strategy": "checkpoint_window",
			"state_stream": "sessions",
			"freshness_strategy": "device_heartbeat"
		},
		{
			"name": "attachments",
			"required": true,
			"description": "Non-message events: hook outputs, tool uses, file snapshots, plus tool-results blob files written to disk.",
			"compaction_fingerprint": {
				"exclude_keys": []
			},
			"display": {
				"label": "Claude Code events",
				"detail": "System events attached to sessions: tool calls, hook outputs, file-history snapshots, permission-mode changes, and persisted tool-result files."
			},
			"semantics": "append_only",
			"schema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"session_id": {
						"type": "string"
					},
					"parent_uuid": {
						"type": ["string", "null"]
					},
					"event_type": {
						"type": ["string", "null"]
					},
					"hook_name": {
						"type": ["string", "null"]
					},
					"tool_use_id": {
						"type": ["string", "null"]
					},
					"content_preview": {
						"type": ["string", "null"]
					},
					"content_bytes": {
						"type": ["integer", "null"]
					},
					"timestamp": {
						"type": ["string", "null"],
						"format": "date-time",
						"x_pdpp_role": "event-time"
					},
					"content_binary_reason": {
						"type": ["string", "null"]
					},
					"blob_ref": {
						"type": ["object", "null"],
						"properties": {
							"blob_id": { "type": "string" },
							"mime_type": { "type": "string" },
							"size_bytes": { "type": "integer" },
							"sha256": { "type": "string" }
						},
						"required": ["blob_id", "mime_type", "size_bytes", "sha256"],
						"additionalProperties": true
					},
					"artifact_capture": {
						"type": ["string", "null"],
						"enum": ["captured", "failed", "unavailable", null]
					},
					"artifact_sha256": {
						"type": ["string", "null"]
					}
				},
				"required": ["id", "session_id"]
			},
			"primary_key": ["id"],
			"cursor_field": "timestamp",
			"consent_time_field": "timestamp",
			"selection": {
				"fields": true,
				"resources": true
			},
			"incremental": true,
			"relationships": [
				{
					"name": "session",
					"stream": "sessions",
					"foreign_key": "session_id",
					"cardinality": "has_one"
				}
			],
			"query": {
				"search": {
					"lexical_fields": ["event_type", "hook_name", "content_preview"],
					"semantic_fields": ["content_preview"]
				},
				"range_filters": {
					"timestamp": ["gte", "gt", "lte", "lt"],
					"content_bytes": ["gte", "gt", "lte", "lt"]
				},
				"aggregations": {
					"count": true,
					"group_by_time": ["timestamp"]
				}
			},
			"coverage_strategy": "checkpoint_window",
			"state_stream": "sessions",
			"freshness_strategy": "device_heartbeat"
		},
		{
			"name": "skills",
			"required": true,
			"description": "User-authored Claude Code skills installed under ~/.claude/skills/<skill>/SKILL.md. Each record captures frontmatter metadata and the full body (capped at 20k chars).",
			"compaction_fingerprint": {
				"exclude_keys": []
			},
			"display": {
				"label": "Your Claude Code skills",
				"detail": "Skill name, description, full SKILL.md body, frontmatter, and on-disk path."
			},
			"semantics": "mutable_state",
			"schema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"name": {
						"type": ["string", "null"],
						"x_pdpp_role": "primary-title"
					},
					"description": {
						"type": ["string", "null"],
						"x_pdpp_role": "secondary"
					},
					"source": {
						"type": ["string", "null"]
					},
					"path": {
						"type": ["string", "null"]
					},
					"content": {
						"type": ["string", "null"],
						"x_pdpp_role": "secondary"
					},
					"frontmatter": {
						"type": ["object", "null"]
					},
					"mtime_epoch": {
						"type": ["integer", "null"]
					}
				},
				"required": ["id"]
			},
			"primary_key": ["id"],
			"cursor_field": "mtime_epoch",
			"selection": {
				"fields": true,
				"resources": true
			},
			"incremental": false,
			"query": {
				"search": {
					"lexical_fields": ["name", "description", "source", "content"],
					"semantic_fields": ["description", "content"]
				},
				"range_filters": {
					"mtime_epoch": ["gte", "gt", "lte", "lt"]
				}
			},
			"coverage_strategy": "snapshot_import_receipt",
			"freshness_strategy": "device_heartbeat"
		},
		{
			"name": "memory_notes",
			"required": true,
			"description": "Project-scoped Claude Code memory notes under ~/.claude/projects/<project>/memory/*.md. Each record captures frontmatter metadata and the note body (capped at 20k chars).",
			"compaction_fingerprint": {
				"exclude_keys": []
			},
			"display": {
				"label": "Your Claude Code memory notes",
				"detail": "Project path, note path, name, description, body, frontmatter, and on-disk path."
			},
			"semantics": "mutable_state",
			"schema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"project_path": {
						"type": "string"
					},
					"note_path": {
						"type": "string"
					},
					"name": {
						"type": ["string", "null"],
						"x_pdpp_role": "primary-title"
					},
					"description": {
						"type": ["string", "null"],
						"x_pdpp_role": "secondary"
					},
					"path": {
						"type": ["string", "null"]
					},
					"content": {
						"type": ["string", "null"]
					},
					"frontmatter": {
						"type": ["object", "null"]
					},
					"mtime_epoch": {
						"type": ["integer", "null"]
					}
				},
				"required": ["id", "project_path", "note_path"]
			},
			"primary_key": ["id"],
			"cursor_field": "mtime_epoch",
			"selection": {
				"fields": true,
				"resources": true
			},
			"incremental": false,
			"query": {
				"search": {
					"lexical_fields": [
						"project_path",
						"note_path",
						"name",
						"description",
						"content"
					],
					"semantic_fields": ["description", "content"]
				},
				"range_filters": {
					"mtime_epoch": ["gte", "gt", "lte", "lt"]
				}
			},
			"coverage_strategy": "checkpoint_window",
			"state_stream": "sessions",
			"freshness_strategy": "device_heartbeat"
		},
		{
			"name": "slash_commands",
			"required": true,
			"description": "User-authored Claude Code slash commands under ~/.claude/commands/*.md. Each record captures frontmatter, the command body (capped at 20k chars), and the file's absolute path.",
			"compaction_fingerprint": {
				"exclude_keys": []
			},
			"display": {
				"label": "Your custom slash commands",
				"detail": "Command name, description, full command body, frontmatter, and on-disk path."
			},
			"semantics": "mutable_state",
			"schema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"name": {
						"type": ["string", "null"],
						"x_pdpp_role": "primary-title"
					},
					"description": {
						"type": ["string", "null"],
						"x_pdpp_role": "secondary"
					},
					"path": {
						"type": ["string", "null"]
					},
					"content": {
						"type": ["string", "null"]
					},
					"frontmatter": {
						"type": ["object", "null"]
					},
					"mtime_epoch": {
						"type": ["integer", "null"]
					}
				},
				"required": ["id"]
			},
			"primary_key": ["id"],
			"cursor_field": "mtime_epoch",
			"selection": {
				"fields": true,
				"resources": true
			},
			"incremental": false,
			"query": {
				"search": {
					"lexical_fields": ["name", "description", "content"],
					"semantic_fields": ["description", "content"]
				},
				"range_filters": {
					"mtime_epoch": ["gte", "gt", "lte", "lt"]
				}
			},
			"coverage_strategy": "snapshot_import_receipt",
			"freshness_strategy": "device_heartbeat"
		},
		{
			"name": "usage",
			"required": true,
			"description": "Aggregate Claude Code usage from ~/.claude/stats-cache.json: total sessions and messages, per-model token/cost totals, day-by-day activity, hour-of-day distribution, and the longest session.",
			"compaction_class": "recurring_snapshot",
			"compaction_class_note": "single aggregate record re-derived in full from stats-cache.json every run; never compactable, never re-alarms as growth accumulates.",
			"compaction_fingerprint": {
				"exclude_keys": []
			},
			"display": {
				"label": "Your Claude Code usage",
				"detail": "Total sessions and messages, per-model token and cost totals, daily activity, hour-of-day distribution, and your longest session."
			},
			"semantics": "mutable_state",
			"schema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"total_sessions": {
						"type": ["integer", "null"]
					},
					"total_messages": {
						"type": ["integer", "null"]
					},
					"first_session_date": {
						"type": ["string", "null"],
						"format": "date-time",
						"x_pdpp_role": "event-time"
					},
					"last_computed_date": {
						"type": ["string", "null"],
						"format": "date"
					},
					"total_speculation_time_saved_ms": {
						"type": ["integer", "null"]
					},
					"total_cost_usd_cents": {
						"type": "integer"
					},
					"currency": {
						"type": "string"
					},
					"models": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"model": { "type": "string" },
								"input_tokens": { "type": "integer" },
								"output_tokens": { "type": "integer" },
								"cache_read_input_tokens": { "type": "integer" },
								"cache_creation_input_tokens": { "type": "integer" },
								"web_search_requests": { "type": "integer" },
								"cost_usd_cents": { "type": "integer" },
								"context_window": { "type": ["integer", "null"] },
								"max_output_tokens": { "type": ["integer", "null"] }
							}
						}
					},
					"daily_activity": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"date": { "type": "string", "format": "date" },
								"message_count": { "type": "integer" },
								"session_count": { "type": "integer" },
								"tool_call_count": { "type": "integer" }
							}
						}
					},
					"daily_model_tokens": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"date": { "type": "string", "format": "date" },
								"tokens_by_model": { "type": "object" }
							}
						}
					},
					"hour_counts": {
						"type": "object"
					},
					"longest_session": {
						"type": ["object", "null"],
						"properties": {
							"session_id": { "type": ["string", "null"] },
							"duration_seconds": { "type": ["integer", "null"] },
							"message_count": { "type": ["integer", "null"] },
							"timestamp": { "type": ["string", "null"], "format": "date-time" }
						}
					},
					"source": {
						"type": "string"
					}
				},
				"required": [
					"id",
					"total_cost_usd_cents",
					"currency",
					"models",
					"daily_activity",
					"daily_model_tokens",
					"hour_counts",
					"source"
				]
			},
			"primary_key": ["id"],
			"selection": {
				"fields": true,
				"resources": true
			},
			"incremental": false,
			"query": {
				"search": {
					"lexical_fields": ["source"]
				},
				"range_filters": {
					"first_session_date": ["gte", "gt", "lte", "lt"],
					"last_computed_date": ["gte", "gt", "lte", "lt"],
					"total_sessions": ["gte", "gt", "lte", "lt"],
					"total_messages": ["gte", "gt", "lte", "lt"]
				},
				"aggregations": {
					"count": true,
					"group_by_time": ["first_session_date"]
				}
			},
			"coverage_strategy": "snapshot_import_receipt",
			"freshness_strategy": "device_heartbeat"
		},
		{
			"name": "file_history",
			"description": "Metadata-only inventory for Claude Code file-history stores. Does not emit file-history payload content.",
			"compaction_fingerprint": {
				"exclude_keys": ["mtime_epoch", "size_bytes"]
			},
			"semantics": "mutable_state",
			"schema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"store": {
						"type": "string"
					},
					"relative_path": {
						"type": "string",
						"x_pdpp_role": "primary-title"
					},
					"path_hash": {
						"type": "string"
					},
					"type": {
						"type": "string"
					},
					"size_bytes": {
						"type": ["integer", "null"]
					},
					"mtime_epoch": {
						"type": ["integer", "null"],
						"x_pdpp_role": "event-time"
					},
					"classification": {
						"type": "string"
					},
					"reason": {
						"type": "string"
					}
				},
				"required": [
					"id",
					"store",
					"relative_path",
					"path_hash",
					"type",
					"classification",
					"reason"
				]
			},
			"primary_key": ["id"],
			"cursor_field": "mtime_epoch",
			"selection": {
				"fields": true,
				"resources": true
			},
