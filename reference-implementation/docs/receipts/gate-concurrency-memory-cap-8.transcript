ails\":{\"type\":\"test\",\"name\":\"manifest validation accepts valid group_by_time / count_distinct declarations\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"manifest validation rejects a non-date group_by_time field\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"manifest validation rejects an unknown count_distinct field\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"group_by other_count is the sum of counts for groups beyond limit\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"group_by other_count is 0 when all groups fit within limit\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"group_by_time other_count covers buckets truncated by limit\"}}\n\n==> test/as-device-decision-outcome-pure.test.ts\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"executeAsDeviceDecision: neither user_code nor approval_id is a 400 invalid_request\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"executeAsDeviceDecision: an approval_id with a non-pending row is a 404 not_found\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"executeAsDeviceDecision: approve dispatches deps.approve with the resolved user code\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"executeAsDeviceDecision: deny dispatches deps.deny (not approve)\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"executeAsDeviceDecision: an approval_id resolves the user code from the pending row\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"executeAsDeviceDecision: a thrown store error is a 