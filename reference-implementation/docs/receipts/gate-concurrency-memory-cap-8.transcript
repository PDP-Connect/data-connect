_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"maintainer code-fix evidence and its owner-state resolver independently prevent a green fleet claim\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"every closed headline state and owner resolver is classified without a healthy fallback\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"informational raw unknown axes do not override the canonical healthy headline\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"headline and reason unknowns remain fleet-unknown\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"unmeasured forward and owner dispositions remain independently load-bearing\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"every closed non-green health member fails the strict fully-healthy claim\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"inventory-minus-summary and summary-minus-inventory disagreements are both unassessed\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"retryable recovery and stalled work each prevent fleet health\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"stale manual or paused policy is advisory rather than a fleet failure\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"banner_warranted: an ordinary late (stale-advisory) source cannot fire the global banner\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"banner_warranted: a schedulable (automatic) connector past its cadence-relative staleness window cannot fire the global banner\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"banner_warranted: a successful current collection cannot be overridden by an older, unrelated false condition\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"banner_warranted: a retryable (background-retry) coverage gap cannot fire the global banner\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"banner_warranted: in-progress work and unassessed/unknown scope (indeterminate) cannot fire the global banner\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"banner_warranted: an actual credential/attention failure still fires needs_owner and the banner\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"banner_warranted: a non-retryable terminal coverage gap still fires the banner as materially blocked\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"banner_warranted: a real runtime outage or stream-health failure still fires the banner\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"banner_warranted: a maintainer code-fix (blocked_maintainer) still fires the banner\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"DISCRIMINATION: ordinary lateness and a provider limit stay silent; a credential failure and a runtime block fire\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"DISCRIMINATION: a real failure beside quiet rows still fires — it is not diluted by healthy neighbours\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"a paused connection is an intentional archive, not part of the active-health denominator\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"detail