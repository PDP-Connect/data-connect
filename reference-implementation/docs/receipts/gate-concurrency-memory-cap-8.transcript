T {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"parseIntegerValue passes through an integer number\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"parseIntegerValue rejects a non-integer number\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"parseIntegerValue parses a clean integer string, tolerating surrounding whitespace\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"parseIntegerValue rejects non-numeric, decimal, and mixed strings\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"parseIntegerValue rejects non-string, non-number inputs\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"assertNonEmptyJsonField accepts arbitrary literal keys\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"assertNonEmptyJsonField rejects empty and non-string values\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"jsonPathForTopLevelField escapes quotes/backslashes so a field cannot break the JSON path\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"single-quote escaping keeps a hostile field name inside its SQL string literal\"}}\n\n==> test/record-expand-helpers-validation.test.ts\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"normalizePrimaryKey: arrays filter non-string/empty; scalar wraps; junk -> []\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"parseIntegerValue: accepts int number / digit strings; rejects floats, blanks, garbage\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"assertNonEmptyJsonField: accepts literal JSON key