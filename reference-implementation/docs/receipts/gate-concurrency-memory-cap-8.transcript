:memory] changed writes allocate unique monotonic versions\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"[conformance:memory] identical re-ingest does not append record_changes or advance version_counter\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"[conformance:memory] repeated ingest delete does not append duplicate delete or advance version_counter\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"[conformance:memory] successful direct delete appends exactly one delete change and advances version_counter once\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"[conformance:memory] direct delete on an absent record is a no-op for record_changes and version_counter\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"[conformance:memory] direct delete on an already-deleted record is a no-op for record_changes and version_counter\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"[conformance:memory] failure between ingest live mutation and record_changes append rolls back the durable unit\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"[conformance:memory] failure between direct-delete live mutation and record_changes append rolls back the durable unit\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"[conformance:memory] record_changes is contiguous across mixed ingest/delete/direct-delete writes\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"[conformance:memory] cleared ingest fault hook has no effect on subsequent ingest\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"[conformance:memory] cleared delete fault hook has no effect on subsequent direct delete\"}}\n\n==> test/record-field-window-substrate.test.ts\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"SQLite: field-window substrate conformance\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"Postgres: field-window substrate conformance (skipped: PDPP_TEST_POSTGRES_URL unset)\",\"skip\":true}}\n\n==> test/record-query-helpers-pure.test.ts\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"validateCanonicalSort: null/empty sort yields null\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"validateCanonicalSort: sign prefix controls direction on the cursor field\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"validateCanonicalSort: a non-cursor field is invalid_sort\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"validateCanonicalSort: no advertised cursor field means nothing is sortable\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"validateCanonicalSort: conflicting directions for the same field is invalid_sort\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"validateCanonicalSort: array form is joined and validated\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"parsePageOrder: asc/desc parsed, default DESC, invalid rejected\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"resolveListOrder: canonical sort direction wins over absent order\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"resolveListOrder: sort and matching legacy order is fine\"}}\nPDPP_TEST_ACCOUNTIN