sh\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"1.5 non-pressure rows are ignored by the pressure-evidence partition\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"1.5 the evidence window is configurable and defaults to the cooldown ceiling\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"1.5 filterFreshPressureRows keeps each row by its OWN freshness, not by reason\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"2.6 all-eligible backlog reports no why_not_now (there is eligible work)\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"2.6 empty backlog is not a blocker (no candidates, no why_not_now)\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"2.6 a fully-deferred cooldown backlog answers why_not_now=cooldown with next_eligible_at\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"2.6 why_not_now prefers owner_required over cooldown when both block\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"2.6 connector defect / quarantine blocks as system_issue\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"2.6 a mix with one eligible row is not blocked (why_not_now omitted)\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"2.6 a fresh domain cooldown defers pressure rows but not non-pressure work\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"2.7 stall cadence constant matches the console surface (6h)\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"2.7 time-free observation never repor