 {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"buildAuditTrace: no scenario_id calls createTraceContext with NO argument\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"buildAuditTrace: a non-string scenario_id is treated as absent\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"buildAuditTrace: sets the reference trace header from the trace context trace_id\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"buildAuditTrace: assembles the request_id/scenario_id/trace_id triple\"}}\n\n==> test/browser-surface-replacement-ledger-store.test.ts\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"SQLite replacement ledger is append-only, redacted, idempotent, and generation-scoped\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"SQLite scoped pending lookup survives a store/controller restart\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"Postgres replacement ledger matches SQLite append/order/selection contract\",\"skip\":true}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"Postgres batch apply blocks a concurrent receipt append until its admitted snapshot commits\",\"skip\":\"PDPP_TEST_POSTGRES_URL unset\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"injectable Postgres append rereads a concurrent opposite resolution\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"Postgres replacement scope contains no NUL byte\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"injectable Postgres scoped pending lookup preserves exact nullable scope\"}}\n\n==> test/boot-orphan-reconciliation.test.ts\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"reconciler emits run.abandoned for legacy orphans with no boot_epoch\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"reconciler does NOT abandon current-epoch runs\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"reconciler is idempotent: second call emits no additional events\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"reconciler preserves the orphan event (append-only invariant)\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"multi-controller isolation: controller B does NOT abandon controller A orphans\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"run_id collision: two orphans with same run_id produce two run.abandoned events\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"cross-boot: reconciler picks up orphans from earlier emission\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"reconciler reports a distinct reason for a run abandoned while awaiting owner interaction\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"reconciler treats an assistance request with no resolution as awaiting the owner\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"reconciler keeps the generic reason once the interaction was answered\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"reconciler keeps the generic reason for a run that never asked for input\"}}\n\n==> test/cadence-lateness.test.ts\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"a source collected within its own interval is on time\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"crossing ONE expected interval is immediately neutral Late — the raw fact is not delayed\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"still neutral late well past the first miss, short of maturity\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"only 3x the interval is MATURE evidence, and even then only a precondition\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"thresholds are relative to each source's OWN cadence, not a global constant\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"the floor applies to ESCALATION only, never to the neutral late fact\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"SILENTLY STOPPED: a source that never fails still becomes overdue\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"no declared interval is UNKNOWN, never late\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"a source that has never succeeded is UNKNOWN, not overdue\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"the deadlines are exposed as plain facts even while on time\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"the two thresholds are nested, never inverted, across a wide cadence range\"}}\n\n==> test/canary-harness-manifest.test.ts\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"OTP denylist covers every connector that texts the owner a code\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"OTP denylist catches wholefoods, which the hand-maintained list missed\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"OTP denylist equals every manifest that declares an OTP posture, computed independently of the harness\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"derivation is fail-closed: a manifest proves safety or it is denied\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"derivation refuses to produce a permissive denylist when manifests cannot be read\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"the triggerable-posture set is closed and excludes every OTP posture\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"OTP denylist resists casing and separator spellings\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"OTP denylist catches wholefoods however the separator is spelled\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"OTP denylist does not over-match unrelated connectors\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"parseManifest REFUSES a connector_run for an OTP-gated connector\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"parseManifest allows a connector_run for a non-denylisted connector\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"parseManifest rejects a floating (non-digest-pinned) base image\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"parseManifest requires at least one artifact assertion\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":