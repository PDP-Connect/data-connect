type\":\"test\",\"name\":\"SQLite: FIRST redemption of a pre-upgrade approved attempt returns an absent expiry\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"SQLite: REPLAY of an already-materialized response_json returns an absent expiry\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"SQLite: replay still returns the normalized body when the healing write fails\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"SQLite: the stored response_json is rewritten so the null cannot resurface\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"SQLite: a REAL expiry survives redemption untouched\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"SQLite: a package-shaped response is NOT altered when it already has no expiry member\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"SQLite: a package-shaped response carrying a REAL expiry is NOT altered\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"SQLite: a package-shaped grant carrying the legacy null IS normalized\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"PostgreSQL: FIRST redemption of a pre-upgrade approved attempt returns an absent expiry\",\"skip\":\"PDPP_TEST_POSTGRES_URL unset or non-dedicated\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"PostgreSQL: REPLAY of an already-materialized response_json returns an absent expiry\",\"skip\":\"PDPP_TEST_POSTGRES_URL unset or non-dedicated\"}}\nPDPP_TEST_ACCOUNTING_EVENT {\"type\":\"test:pass\",\"details\":{\"type\":\"test\",\"name\":\"PostgreSQL: replay still returns the normalized body when the healing write fails\",\"skip\":\"PDPP_TEST