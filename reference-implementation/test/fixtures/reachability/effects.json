{
  "recipe/probe": {
    "cases": [
      {
        "args": ["status", "--json", "--peers=false"],
        "output": "node-status"
      },
      { "args": ["serve", "status", "--json"], "output": "serve-config" },
      {
        "args": ["-V"],
        "result": { "stdout": "", "stderr": "OpenSSH_9.9p1\n", "exitCode": 0 }
      },
      {
        "args": ["--version"],
        "result": {
          "stdout": "cloudflared version 2026.1.0\n",
          "stderr": "",
          "exitCode": 0
        }
      }
    ],
    "nodeStatus": {
      "BackendState": "Running",
      "Self": {
        "ID": "fixture-node",
        "DNSName": "fixture.invalid.",
        "TailscaleIPs": [],
        "CapMap": {
          "funnel": [],
          "https": [],
          "https://tailscale.com/cap/funnel-ports?ports=443,8443,10000": []
        }
      },
      "CurrentTailnet": {
        "MagicDNSSuffix": "fixture.invalid",
        "MagicDNSEnabled": true
      },
      "CertDomains": ["fixture.invalid"]
    }
  },
  "local-api/request": {
    "statusPath": "/localapi/v0/status?peers=false",
    "configPath": "/localapi/v0/serve-config"
  },
  "spawn/run": {
    "trialArgs": ["-R"],
    "trialOutput": "https://fixture.lhr.life\n",
    "publicArgs": ["funnel"],
    "privateArgs": ["serve"],
    "httpsPrefix": "--https="
  }
}
