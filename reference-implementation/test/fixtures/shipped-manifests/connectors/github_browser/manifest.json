			"schema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"username": {
						"type": "string",
						"x_pdpp_role": "primary-title"
					},
					"fullName": {
						"type": "string"
					},
					"bio": {
						"type": "string"
					},
					"company": {
						"type": "string"
					},
					"location": {
						"type": "string"
