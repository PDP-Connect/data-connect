					"repositoryCount": {
						"type": "number"
					},
					"profileUrl": {
						"type": "string"
					},
					"pinnedRepositories": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"fullName": {
									"type": "string"
								},
								"url": {
									"type": [
										"string",
										"null"
									]
								},
								"description": {
									"type": "string"
								},
								"language": {
									"type": [
										"string",
										"null"
									]
								},
								"stars": {
									"type": "number"
								},
								"forks": {
									"type": "number"
								},
								"forkedFrom": {
									"type": "string"
								}
							},
							"required": [
								"fullName"
							],
							"additionalProperties": false
						}
					},
					"organizations": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"login": {
									"type": "string"
								},
								"label": {
									"type": "string"
								},
								"url": {
