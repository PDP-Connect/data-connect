										"string",
										"null"
									]
								}
							},
							"required": [
								"name"
							],
							"additionalProperties": false
						}
					},
					"contributionsLastYear": {
						"type": [
							"number",
							"null"
						]
					}
				},
				"required": [
					"id",
					"username",
					"profileUrl"
				],
				"additionalProperties": false
