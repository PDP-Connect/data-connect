{
  "name": "@pdpp/brand-react",
  "version": "0.1.0",
  "private": true,
  "description": "Ink Carbon React component library — the framework-bound layer atop @pdpp/brand tokens. Ships .tsx sources directly (no build step); transpiled by the consuming app's Next bundler via transpilePackages. Component styling (components.css / shell.css) ships alongside the components.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./components.css": "./src/components.css",
    "./product-identity": "./src/product-identity.ts",
    "./shell.css": "./src/shell.css"
  },
  "scripts": {
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "node --import tsx ../../scripts/test-scratch/run-command.ts -- node ../../scripts/run-node-tests.mjs --test --import tsx --import ./css-stub-register.ts \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm check && pnpm test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@pdpp/brand": "*",
    "@pdpp/display": "*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsdom": "30.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "8.0.1"
  },
  "peerDependencies": {
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
