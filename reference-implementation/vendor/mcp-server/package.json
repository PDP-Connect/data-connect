{
  "name": "@pdpp/mcp-server",
  "version": "0.0.0",
  "description": "Local stdio MCP adapter for grant-scoped PDPP reads and event-subscription management.",
  "type": "module",
  "bin": {
    "pdpp-mcp-server": "./dist/bin/pdpp-mcp-server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./server": {
      "types": "./dist/src/server.d.ts",
      "import": "./dist/src/server.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "npm --prefix ../cli run build && node --import tsx scripts/build.ts",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test": "npm run build && node --import tsx ../../../scripts/test-scratch/run-command.ts -- node ../../../scripts/run-node-tests.mjs --test --import tsx \"test/*.test.ts\" test/smoke-stdio.ts",
    "test:read-surface": "node --import tsx ../../../scripts/test-scratch/run-command.ts -- node ../../../scripts/run-node-tests.mjs --test --import tsx \"test/*.test.ts\" test/smoke-stdio.ts",
    "validate:package": "npm run build && node --import tsx scripts/package-contract.ts",
    "verify:artifact": "npm run build && node --import tsx scripts/pack-install-run.ts",
    "verify": "npm test && npm run validate:package && npm run verify:artifact",
    "pack:dry-run": "npm run build && npm pack --dry-run --ignore-scripts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@pdpp/cli": "*",
    "@pdpp/read-core": "*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  },
  "keywords": [
    "pdpp",
    "personal-data",
    "mcp",
    "model-context-protocol"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PDP-Connect/data-connect.git",
    "directory": "reference-implementation/vendor/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/PDP-Connect/data-connect/issues"
  },
  "homepage": "https://github.com/PDP-Connect/data-connect/tree/main/reference-implementation/vendor/mcp-server#readme",
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false,
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  }
}
