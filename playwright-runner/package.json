{
  "name": "dataconnect-playwright-runner",
  "version": "1.0.0",
  "description": "Playwright sidecar for DataConnect connectors",
  "main": "index.cjs",
  "type": "module",
  "scripts": {
    "start": "node index.cjs",
    "build": "node scripts/build.js",
    "build:lean": "node scripts/build.js --lean"
  },
  "pkg": {
    "assets": [],
    "targets": [
      "node22-macos-arm64",
      "node22-macos-x64",
      "node22-win-x64",
      "node22-linux-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.12.0"
  }
}
