{
  "name": "dataconnect",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/console",
    "reference-implementation",
    "reference-implementation/vendor/*"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:app": "vite --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "prebuild:all": "node scripts/ensure-connectors.js && node scripts/ensure-pdpp-runtime.js && node scripts/ensure-playwright-runner.js && node scripts/ensure-personal-server.js",
    "connectors:resolve": "node scripts/resolve-connectors.js",
    "connectors:install": "npm run connectors:resolve",
    "connectors:upgrade": "npm run connectors:resolve",
    "connectors:check": "npm run connectors:resolve -- --check",
    "connectors:resolve:check": "npm run connectors:check",
    "spdx-headers:check": "node scripts/check-spdx-headers.mjs",
    "platform-registry:generate": "node scripts/generate-platform-registry.js",
    "test:honest-telemetry-conformance": "node playwright-runner/result-classifier.conformance.test.cjs",
    "pretauri:dev": "npm run prebuild:all",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "typecheck": "tsc -b --noEmit",
    "test": "npm run typecheck && vitest run",
    "test:pdpp-interop": "node --test scripts/pdpp-interoperability-e2e.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:icon": "tauri icon ./public/data_connect_1024_1x.png",
    "tauri:icon:refresh-cache": "sh -c 'tauri icon ./public/data_connect_1024_1x.png && rm -rf \"$HOME/Library/Caches/com.apple.iconservices\" \"$HOME/Library/Caches/com.apple.iconservices.store\" && (qlmanage -r cache || true) && (killall iconservicesagent || true) && (killall Dock || true) && (killall Finder || true)'",
    "tauri:icon:rebuild": "sh -c 'tauri icon ./public/data_connect_1024_1x.png && npm run tauri:build && rm -rf \"$HOME/Library/Caches/com.apple.iconservices\" \"$HOME/Library/Caches/com.apple.iconservices.store\" && (qlmanage -r cache || true) && (killall iconservicesagent || true) && (killall Dock || true) && (killall Finder || true)'",
    "tauri:dev": "node scripts/sync-connectors-dev.js && tauri dev",
    "demo:chatgpt-endpoint": "sh -c 'PORT=${DATACONNECT_DEMO_PORT:-8787}; lsof -ti tcp:$PORT -sTCP:LISTEN | xargs kill -9 2>/dev/null || true; DATACONNECT_DEMO_PORT=$PORT node --watch scripts/demo-chatgpt-endpoint.mjs'",
    "demo:chatgpt-endpoint:once": "sh -c 'PORT=${DATACONNECT_DEMO_PORT:-8787}; lsof -ti tcp:$PORT -sTCP:LISTEN | xargs kill -9 2>/dev/null || true; DATACONNECT_DEMO_PORT=$PORT node scripts/demo-chatgpt-endpoint.mjs'",
    "tauri:build": "node scripts/build-prod.js",
    "release:github": "node scripts/release-github.mjs",
    "release:versions": "node scripts/release-github.mjs --show-versions",
    "release:npm": "semantic-release",
    "release:npm:dry-run": "semantic-release --dry-run --no-ci",
    "skills:sync": "node scripts/sync-skills.js",
    "skills:watch": "node scripts/watch-skills.js",
    "postinstall": "node scripts/sync-skills.js && node scripts/fetch-connectors.js",
    "fresh-start": "bash scripts/fresh-start.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@tabler/icons-react": "^3.49.0",
    "@tauri-apps/api": "~2.12.3",
    "@tauri-apps/cli": "~2.12.2",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.2",
    "@tauri-apps/plugin-deep-link": "^2.6.1",
    "@tauri-apps/plugin-http": "^2.8.2",
    "@tauri-apps/plugin-shell": "^2.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.57.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opendatalabs/data-connectors-tools": "github:PDP-Connect/data-connectors#ee11b09dc4e4c3acb1a1e0606ced0429f761be27",
    "@semantic-release/exec": "^7.1.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "js-yaml": "^5.4.3",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "shadcn": "^4.21.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@huggingface/transformers": {
      "sharp": "^0.35.4"
    },
    "qs": "^6.15.2"
  }
}
