{
  "name": "@pdpp/collector-runtime",
  "version": "0.0.1",
  "description": "Generic connector-execution runtime for PDPP local (device-side) collection: the collector loop, device-exporter ingest client, durable outbox, and runtime-capabilities placement gate. Depends on @pdpp/connector-protocol for the connector authoring contract (wire-protocol types, JSONL primitives). Connector-agnostic \u2014 carries no connector definitions or content.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PDP-Connect/data-connect.git",
    "directory": "packages/collector-runtime"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./collector-build-info": {
      "types": "./dist/collector-build-info.d.ts",
      "import": "./dist/collector-build-info.js"
    },
    "./collector-runner": {
      "types": "./dist/collector-runner.d.ts",
      "import": "./dist/collector-runner.js"
    },
    "./local-device-client": {
      "types": "./dist/local-device-client.d.ts",
      "import": "./dist/local-device-client.js"
    },
    "./local-device-envelope": {
      "types": "./dist/local-device-envelope.d.ts",
      "import": "./dist/local-device-envelope.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "node --experimental-strip-types scripts/build.ts",
    "check": "ultracite check",
    "check:noUnnecessaryConditions-expiry": "node ./scripts/check-no-unnecessary-conditions-expiry.ts",
    "fix": "ultracite fix",
    "prepack": "npm run build",
    "test": "node --test --import tsx --test-concurrency=2 --test-timeout=120000 \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run check && npm run check:noUnnecessaryConditions-expiry && npm test"
  },
  "dependencies": {
    "@pdpp/connector-protocol": ">=0.0.1 <1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.11",
    "ultracite": "7.10.6"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/",
    "tag": "latest",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./collector-build-info": {
        "types": "./dist/collector-build-info.d.ts",
        "import": "./dist/collector-build-info.js"
      },
      "./collector-runner": {
        "types": "./dist/collector-runner.d.ts",
        "import": "./dist/collector-runner.js"
      },
      "./local-device-client": {
        "types": "./dist/local-device-client.d.ts",
        "import": "./dist/local-device-client.js"
      },
      "./local-device-envelope": {
        "types": "./dist/local-device-envelope.d.ts",
        "import": "./dist/local-device-envelope.js"
      }
    }
  }
}
