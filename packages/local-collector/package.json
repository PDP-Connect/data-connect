{
  "name": "@pdpp/local-collector",
  "version": "0.0.1",
  "description": "Local collector runtime for PDPP: installs pinned, signed Collection Profiles for filesystem-class connectors (Claude Code, Codex, Google Takeout, iMessage, Apple Photos) and runs them with the device-exporter ingest client.",
  "keywords": [
    "pdpp",
    "personal-data",
    "collector",
    "data-portability"
  ],
  "homepage": "https://github.com/PDP-Connect/data-connect#readme",
  "bugs": {
    "url": "https://github.com/PDP-Connect/data-connect/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PDP-Connect/data-connect.git",
    "directory": "packages/local-collector"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/local-collector/src/runner.d.ts",
      "import": "./dist/local-collector/src/runner.js"
    },
    "./runner": {
      "types": "./dist/local-collector/src/runner.d.ts",
      "import": "./dist/local-collector/src/runner.js"
    },
    "./errors": {
      "types": "./dist/local-collector/src/errors.d.ts",
      "import": "./dist/local-collector/src/errors.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/local-collector/src/runner.js",
  "types": "./dist/local-collector/src/runner.d.ts",
  "bin": {
    "pdpp-local-collector": "dist/local-collector/bin/pdpp-local-collector.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build --workspace=@pdpp/connector-protocol --workspace=@pdpp/collector-runtime && rm -rf dist && tsc -p tsconfig.build.json && tsx scripts/postbuild.ts",
    "prepack": "npm run build",
    "pack-install-run": "node --import tsx scripts/pack-install-run.ts",
    "pin:collection-profiles": "tsx scripts/pin-collection-profiles.ts",
    "test": "tsx scripts/run-tests.ts",
    "validate:package": "tsx scripts/validate-package.ts",
    "verify": "npm test && npm run validate:package && npm run pack-install-run"
  },
  "dependencies": {
    "@sigstore/bundle": "^5.0.0",
    "ajv": "^8.20.0",
    "sigstore": "^5.0.0",
    "tar": "^7.5.22",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@opendatalabs/data-connectors-tools": "github:PDP-Connect/data-connectors#6c71697a1523926fe8d475cd243a8219ea21aa5b",
    "@pdpp/collector-runtime": "0.0.1",
    "@pdpp/connector-protocol": "0.0.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  }
}
