{
  "name": "@pdpp/local-collector",
  "version": "0.0.0",
  "private": true,
  "description": "Local collector runtime for PDPP: filesystem-class connectors (Claude Code, Codex, Google Takeout, iMessage, Apple Photos, Google Messages) plus the device-exporter ingest client.",
  "keywords": [
    "pdpp",
    "personal-data",
    "collector",
    "data-portability"
  ],
  "homepage": "https://github.com/PDP-Connect/data-connect#readme",
  "bugs": {
    "url": "https://github.com/PDP-Connect/data-connect/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PDP-Connect/data-connect.git",
    "directory": "packages/local-collector"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/local-collector/src/runner.d.ts",
      "import": "./dist/local-collector/src/runner.js"
    },
    "./runner": {
      "types": "./dist/local-collector/src/runner.d.ts",
      "import": "./dist/local-collector/src/runner.js"
    },
    "./errors": {
      "types": "./dist/local-collector/src/errors.d.ts",
      "import": "./dist/local-collector/src/errors.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/local-collector/src/runner.js",
  "types": "./dist/local-collector/src/runner.d.ts",
  "bin": {
    "pdpp-local-collector": "dist/local-collector/bin/pdpp-local-collector.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build --workspace=@pdpp/collector-runtime --workspace=@pdpp/connector-protocol && rm -rf dist && tsc -p tsconfig.build.json && tsx scripts/postbuild.ts",
    "prepack": "npm run build",
    "pack-install-run": "node --import tsx scripts/pack-install-run.ts",
    "prepare": "npm run build",
    "test": "tsx scripts/run-tests.ts",
    "validate:package": "tsx scripts/validate-package.ts",
    "verify": "npm test && npm run validate:package"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@pdpp/collector-runtime": "*",
    "@pdpp/connector-protocol": "*",
    "playwright": "^1.62.1",
    "tsx": "^4.23.11"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false,
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  }
}
