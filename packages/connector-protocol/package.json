{
  "name": "@pdpp/connector-protocol",
  "version": "0.0.2",
  "description": "The connector authoring contract for PDPP: the JSONL wire-protocol message types, the LocalCollectorDefinition type contract, the bootstrap/emit/scope-filter primitives connector authors import directly, and small text/auth/retry utilities connectors depend on. Bottom of the dependency graph \u2014 depends on nothing in @pdpp/collector-runtime or @pdpp/polyfill-connectors, so connector authors never pull in the runtime package or its release cadence just to get the files they author against.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PDP-Connect/data-connect.git",
    "directory": "packages/connector-protocol"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./collector-definition": {
      "types": "./dist/collector-definition.d.ts",
      "import": "./dist/collector-definition.js"
    },
    "./connector-runtime-protocol": {
      "types": "./dist/connector-runtime-protocol.d.ts",
      "import": "./dist/connector-runtime-protocol.js"
    },
    "./http-retry": {
      "types": "./dist/http-retry.d.ts",
      "import": "./dist/http-retry.js"
    },
    "./pdpp-safe-text": {
      "types": "./dist/pdpp-safe-text.d.ts",
      "import": "./dist/pdpp-safe-text.js"
    },
    "./safe-text-preview": {
      "types": "./dist/safe-text-preview.d.ts",
      "import": "./dist/safe-text-preview.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "artifact:generate": "node scripts/package-artifact.mjs generate",
    "artifact:verify": "node scripts/package-artifact.mjs verify",
    "build": "node --experimental-strip-types scripts/build.ts",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepack": "npm run build",
    "test": "node --test --import tsx --test-concurrency=2 --test-timeout=120000 \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run check && npm test && npm run artifact:verify"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "^24.10.1",
    "tsx": "^4.23.11",
    "ultracite": "7.10.2"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./auth": {
        "types": "./dist/auth.d.ts",
        "import": "./dist/auth.js"
      },
      "./collector-definition": {
        "types": "./dist/collector-definition.d.ts",
        "import": "./dist/collector-definition.js"
      },
      "./connector-runtime-protocol": {
        "types": "./dist/connector-runtime-protocol.d.ts",
        "import": "./dist/connector-runtime-protocol.js"
      },
      "./http-retry": {
        "types": "./dist/http-retry.d.ts",
        "import": "./dist/http-retry.js"
      },
      "./pdpp-safe-text": {
        "types": "./dist/pdpp-safe-text.d.ts",
        "import": "./dist/pdpp-safe-text.js"
      },
      "./safe-text-preview": {
        "types": "./dist/safe-text-preview.d.ts",
        "import": "./dist/safe-text-preview.js"
      }
    },
    "provenance": true,
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  }
}
