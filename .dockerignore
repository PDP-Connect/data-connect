.git
node_modules
**/node_modules
.next
**/.next
dist
**/dist
coverage
tmp
**/tmp
*.log
/reference-implementation/vendor/pdpp-polyfill-connectors-0.0.1.tgz

# Operator secrets. .env.docker.example tells operators to create .env.docker
# (owner password, credential encryption key, connector passwords) here, and
# every Dockerfile does `COPY . .`. Unlike .gitignore, patterns here are
# anchored at the context root, hence **/. Keep the committed *.example templates.
# deploy/docker/check-image-secrets.sh enforces this in CI.
**/.env
**/.env.*
**/*.env
**/.envrc
!**/.env*.example
!**/*.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/id_rsa
**/id_dsa
**/id_ecdsa
**/id_ed25519
**/.netrc
**/credentials.json
**/service-account*.json

# Local dev databases (`npm run dev` writes .pdpp-data/pdpp.sqlite) hold
# personal data.
**/.pdpp-data
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*

# The ! rules above would re-include matching files inside the trees excluded
# at the top of this file, so exclude everything under those trees again
# (a bare directory pattern here does not undo a ! rule). Keep this block last.
.git/**
node_modules/**
**/node_modules/**
.next/**
**/.next/**
dist/**
**/dist/**
coverage/**
tmp/**
**/tmp/**
