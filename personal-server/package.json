{
  "name": "dataconnect-personal-server",
  "version": "1.0.0",
  "description": "Personal Server wrapper for DataConnect",
  "main": "index.cjs",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "start:cjs": "node index.cjs",
    "build": "node scripts/build.js",
    "test": "node --test pdpp/*.test.js pdpp/github-authorization/*.test.js pdpp/test/*.test.js test/*.test.js",
    "test:pdpp": "node --test pdpp/test/*.test.js",
    "test:security": "node --test test/protected-routes.test.js scripts/*.test.js"
  },
  "pkg": {
    "assets": [
      "node_modules/@opendatalabs/personal-server-ts-*/dist/**/*",
      "node_modules/@opendatalabs/personal-server-ts-*/package.json",
      "node_modules/@hono/node-server/dist/**/*",
      "node_modules/@hono/node-server/package.json",
      "node_modules/hono/**/*"
    ],
    "targets": [
      "node22-macos-arm64",
      "node22-macos-x64",
      "node22-win-x64",
      "node22-linux-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opendatalabs/personal-server-ts-core": "^1.16.1",
    "@opendatalabs/personal-server-ts-mcp": "^0.2.0",
    "@opendatalabs/personal-server-ts-server": "^1.16.1",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.7",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0",
    "esbuild": "^0.28.2"
  }
}
