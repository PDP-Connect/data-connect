# Copy to .env beside docker-compose.yml, then run generate-secrets.sh.
# Every active key below is read by deploy/docker/docker-compose.yml.
PDPP_CREDENTIAL_ENCRYPTION_KEY=
PDPP_POSTGRES_PASSWORD=

# Leave this empty to claim the node at /setup with a one-time setup token.
# Set it before first boot if you manage the owner password separately.
PDPP_OWNER_PASSWORD=

# Optional overrides. Keep origin and port aligned when changing either.
# PDPP_WEB_PORT=7662
# PDPP_REFERENCE_ORIGIN=http://localhost:7662
# PDPP_BIND_HOST=127.0.0.1
# PDPP_TRUSTED_HOSTS=localhost,127.0.0.1
# PDPP_EMBEDDING_DOWNLOAD_ALLOWED=0
# PDPP_CORE_IMAGE=ghcr.io/pdp-connect/data-connect/core:latest
